{
  "contract_version": "0.1",
  "frozen_on": "2026-09-19",
  "mechanism_id": "corporate_investment_response",
  "phase": "Corporate Investment — Offline Measurement Panel",
  "purpose": "Deterministically derive only the measurement series frozen by the corporate-investment measurement-design contract from retained immutable source vintages. This phase creates an aligned quarterly measurement panel and coverage diagnostics. It performs no parameter estimation, lag selection, baseline comparison, holdout inspection, causal identification or feedback activation.",
  "measurement_design_contract": "model/calibration_validation/corporate_investment_measurement_design_contract.json",
  "retained_source_vintages": {
    "core": "data/source_vintages/corporate-investment-source-family-vintage-2026-09-19",
    "supplemental": "data/source_vintages/corporate-investment-supplemental-source-vintage-2026-09-19"
  },
  "inputs": {
    "target": "nfc_investment_rate_quarterly_level.csv",
    "grants": "nfc_investment_grants_quarterly_level.csv",
    "lending_rate_monthly": "nfc_new_business_lending_rate_monthly_level.csv",
    "nfc_gva": "nfc_gva_quarterly_level.csv",
    "real_gdp": "real_gdp_quarterly_level.csv"
  },
  "transformations": {
    "target_investment_rate": "USE_PROVIDER_PUBLISHED_LEVEL_UNCHANGED",
    "real_gdp_yoy_growth": "100 * (real_gdp[t] / real_gdp[t-4] - 1)",
    "investment_grants_support_intensity": "100 * SUM(grants[t-3:t]) / SUM(nfc_gva[t-3:t])",
    "nfc_new_business_lending_rate_quarterly_mean": "ARITHMETIC_MEAN_OF_EXACTLY_THREE_MONTHLY_VALUES_WITHIN_QUARTER"
  },
  "completeness_rules": {
    "quarter_sequence_must_be_consecutive": true,
    "real_gdp_requires_t_and_t_minus_4": true,
    "support_intensity_requires_four_consecutive_grant_and_gva_quarters": true,
    "support_intensity_denominator_must_be_positive": true,
    "lending_rate_requires_exactly_three_distinct_finite_months": true,
    "interpolation_allowed": false,
    "forward_fill_allowed": false,
    "missing_to_zero_allowed": false
  },
  "panel_columns": [
    "period",
    "nfc_investment_rate",
    "real_gdp_yoy_growth",
    "investment_grants_support_intensity",
    "nfc_new_business_lending_rate_quarterly_mean"
  ],
  "hard_rules": {
    "no_parameter_estimation": true,
    "no_model_selection": true,
    "no_lag_selection": true,
    "no_autoregressive_order_selection": true,
    "no_sign_gate_evaluation": true,
    "no_holdout_opening": true,
    "no_causal_claim": true,
    "no_system_dynamics_activation": true,
    "no_behavioural_closure_change": true,
    "offline_only": true
  },
  "output_files": {
    "panel": "corporate_investment_measurement_panel.csv",
    "audit": "corporate_investment_measurement_panel_audit.json"
  },
  "pass_effect": "MEASUREMENT_PANEL_READY_FOR_PREREGISTERED_STRUCTURAL_SELECTION_DESIGN_ONLY",
  "next_gate": "Freeze an explicit structural-selection contract, including candidate equation family, baseline, lag/order choices, selection and final-evaluation windows, parameter-domain gates and failure criteria, before any fit."
}
